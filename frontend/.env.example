# Public configuration only. Everything prefixed with VITE_ is embedded in the browser bundle,
# so never put database URLs, service keys or other secrets here.
# Local dev only. Do not set this on Vercel. The live site calls /api/v1 on its own host.
# A localhost value in the Vercel project is ignored by the production build.
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Absolute public URL of the site, used for canonical/Open Graph links (optional)
VITE_SITE_URL=http://localhost:5173
