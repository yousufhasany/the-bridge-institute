# Tests never use backend/.env. They read only TEST_DATABASE_URL (optional) and refuse to run
# against a database whose name does not contain "test". Default:
#   postgresql://postgres:postgres@localhost:5433/bridge_test   (started by `npm run db:local`)
# To use a separate Supabase project or branch for tests, set this variable in your shell/CI:
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bridge_test
