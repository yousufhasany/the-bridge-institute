# ---------------------------------------------------------------------------
# The Bridge Institute - backend environment (copy to .env and fill in)
# Never commit real values. None of these may be exposed to the frontend
# or stored in the Vercel project. Set them only on the API host.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
WEB_ORIGIN=http://localhost:5173

# Public URL of the frontend (used to build password-reset / invitation links)
APP_URL=http://localhost:5173

# Supabase PostgreSQL
#  DATABASE_URL: pooled connection (Supavisor, port 6543) with ?pgbouncer=true
#  DIRECT_URL:   direct/session connection (port 5432) used by Prisma Migrate
# For local development without Supabase run `npm run db:local` at the repo root and use:
#  postgresql://postgres:postgres@localhost:5433/bridge_dev
DATABASE_URL=YOUR_POSTGRESQL_CONNECTION_STRING
DIRECT_URL=YOUR_DIRECT_DATABASE_CONNECTION

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
SESSION_TTL_HOURS=72
# lax (recommended when frontend and API share a registrable domain) | strict | none (requires HTTPS)
COOKIE_SAMESITE=lax

# Supabase Storage (optional - uploads are disabled until configured)
STORAGE_URL=
STORAGE_SERVICE_KEY=
STORAGE_PUBLIC_BUCKET=public-media
STORAGE_PRIVATE_BUCKET=private-files

# Transactional email via Resend (optional). Without it, emails are not sent.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

LOG_LEVEL=info
